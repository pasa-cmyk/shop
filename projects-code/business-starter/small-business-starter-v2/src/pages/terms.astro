---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import LegalPage from '../components/LegalPage.astro';
import { brand } from '../config/brand';
import { termsOfService } from '../data/terms';
---

<BaseLayout title="Terms of Service" description={`Terms of Service for ${brand.name}. Review the terms that govern use of our website and services.`}>
  <Header slot="header" />

  <Banner title="Terms of Service" />

  <LegalPage effectiveDate={termsOfService.effectiveDate} sections={termsOfService.sections} />

  <Footer slot="footer" />
</BaseLayout>
