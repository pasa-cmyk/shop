---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import LegalPage from '../components/LegalPage.astro';
import { brand } from '../config/brand';
import { privacyPolicy } from '../data/privacy';
---

<BaseLayout title="Privacy Policy" description={`Privacy Policy for ${brand.name}. Learn how we collect, use, and protect your information.`}>
  <Header slot="header" />

  <Banner title="Privacy Policy" />

  <LegalPage effectiveDate={privacyPolicy.effectiveDate} sections={privacyPolicy.sections} />

  <Footer slot="footer" />
</BaseLayout>
